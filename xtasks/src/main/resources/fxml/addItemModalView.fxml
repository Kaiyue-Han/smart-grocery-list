      </image>
   </ImageView>
    <Text fill="WHITE" layoutX="100.0" layoutY="75.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Category" wrappingWidth="66.0">
      <font>
         <Font name="System Bold" size="14.0" />
      </font>
    </Text>
   <MenuButton fx:id="categoryBox" layoutX="100.0" layoutY="85.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="151.0" text="Category">
