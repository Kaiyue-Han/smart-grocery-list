               <children>
            
                                                            <Label text="   Suggestions   " HBox.hgrow="NEVER" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="addall" minWidth="65.0" mnemonicParsing="false" onAction="#addallAction" prefHeight="23.0" text="Add all" HBox.hgrow="NEVER">
                     <HBox.margin>
                        <Insets right="20.0" />
                     </HBox.margin>
                  </Button>
                   <Button fx:id="rejectall" mnemonicParsing="false" onAction="#rejectallAction" text="Reject all" HBox.hgrow="NEVER">
                     <HBox.margin>
                        <Insets right="20.0" />
                     </HBox.margin>
                  </Button>
               </children>
            </HBox>
            <TableView fx:id="stableView" prefHeight="232.0" prefWidth="599.0">
              <columns>
                  <TableColumn fx:id="snameColumn" prefWidth="75.0" text="Name   ↕" />
                  <TableColumn fx:id="scategoryColumn" prefWidth="75.0" text="Category   ↕" />
                  <TableColumn fx:id="squantityColumn" prefWidth="75.0" text="Quantity" />
                  <TableColumn fx:id="sunitColumn" prefWidth="75.0" text="Unit" />
                  <TableColumn fx:id="saddColumn" prefWidth="75.0" text="Add" />
                  <TableColumn fx:id="rejectColumn" prefWidth="75.0" text="Reject" />
                  <TableColumn fx:id="reasonColumn" prefWidth="130.0" text="Reason" />
              </columns>
            </TableView>
         </children></VBox>
    </children>
