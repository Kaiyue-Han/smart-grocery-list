            <Font size="14.0" />
         </font></Text>
      <Text fx:id="deletefeedback" fill="#339900" layoutX="194.0" layoutY="53.0" strokeType="OUTSIDE" strokeWidth="0.0" AnchorPane.leftAnchor="170.0" AnchorPane.topAnchor="60.0">
         <font>
            <Font size="14.0" />
         </font></Text>
      <Button fx:id="suggestion" mnemonicParsing="false" onAction="#suggestionAction" prefHeight="23.0" prefWidth="579.0" style="-fx-background-color: #DCDCDC;" text="Suggestion" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" />
      <VBox fx:id="vbox" prefHeight="297.0" prefWidth="599.0" style="-fx-background-color: #F5F5F5;" AnchorPane.bottomAnchor="-297.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
         <children>
            <Button fx:id="close" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: #DCDCDC;" text="▼" />
